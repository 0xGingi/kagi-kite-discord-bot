{
  "name": "kagi-kite-discord-bot",
  "version": "1.2.0",
  "description": "Discord bot that scrapes Kagi Kite news and posts summarized articles",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f kagi-kite-bot"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "axios": "^1.11.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.9.2",
    "eslint": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0"
  },
  "keywords": ["discord", "bot", "kagi", "kite", "news", "summarizer"],
  "author": "",
  "license": "MIT"
}